# AmanAI Frontend — copy to .env.local and fill in values

# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AWS Cognito
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# Hosted UI domain (optional — only needed if using hosted UI redirect)
NEXT_PUBLIC_COGNITO_DOMAIN=amanai.auth.us-east-1.amazoncognito.com
